# Build output (generated by build.py, published to Netlify from dist/)
dist/

# Local AI-plan draft (not part of the deployed site; skipped by build.py and check_links.py)
/claudplan4gg/

# Python bytecode
__pycache__/
*.pyc
.freebuff/
*.backup
screenshot-*.png
/*.png

.wrangler/

# Netlify CLI state left by the manual retire deploy (site id, deploy cache).
.netlify/

# Raw camera originals, sorted by job for the recent-work gallery. build.py
# already excludes this path from dist/ (343 MB, and the frames carry GPS EXIF),
# so nothing in here is ever published - the derivatives that ship live beside
# the pages that use them. Originals stay out of history: commit the cut
# versions, not the negatives.
img/photos-to-sort/

# Cloudflare Web Analytics site token. It ships in every page, so it is not a
# secret - but keeping it untracked means a commit can never silently start or
# stop measuring. build.py reads this when CF_ANALYTICS_TOKEN is unset.
.analytics-token
